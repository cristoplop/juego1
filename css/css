/* =====================================================
   ESTILOS PRINCIPALES - PANTALLA DE INICIO
   ===================================================== */

/* ----- CUERPO DEL DOCUMENTO ----- */
body {
    background: linear-gradient(to bottom, #87CEEB, white);
    font-family: Arial, sans-serif;
    text-align: center;
    margin: 0;
    padding: 20px;
}

/* ----- TÍTULOS ----- */
h1 {
    color: orange;
    font-size: 40px;
}

h3 {
    color: white;
}

/* ----- CONTENEDORES ----- */
.contenedor {
    width: 850px;
    margin: auto;
    padding: 30px;
    border-radius: 20px;
    background-image: url('../img/fondo.jpg');
    background-size: cover;
    background-position: center;
    box-shadow: 0px 0px 20px black;
}

.contenido {
    background: rgba(0, 0, 0, 0.6);
    padding: 20px;
    border-radius: 20px;
}

/* ----- CAMPOS DE ENTRADA ----- */
input {
    padding: 12px;
    width: 250px;
    border-radius: 10px;
    border: 2px solid orange;
    font-size: 16px;
}

/* ----- GALERÍA DE AVATARES ----- */
.avatares {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.avatares img {
    width: 120px;
    height: 120px;
    border-radius: 15px;
    cursor: pointer;
    transition: 0.3s;
    border: 3px solid transparent;
}

.avatares img:hover {
    transform: scale(1.1);
    border: 3px solid orange;
}

.seleccionado {
    border: 4px solid yellow !important;
}

/* ----- BOTONES ----- */
button {
    padding: 12px 25px;
    border: none;
    border-radius: 10px;
    background: orange;
    font-size: 18px;
    cursor: pointer;
    margin-top: 20px;
    transition: 0.3s;
}

button:hover {
    background: orangered;
    color: white;
}

/* ----- ANIMACIONES ----- */
.efecto {
    animation: colores 0.5s infinite;
}

@keyframes colores {
    0% { background: red; }
    50% { background: orange; }
    100% { background: yellow; }
}

/* ----- PANTALLA DE BIENVENIDA ----- */
.bienvenidaCaja {
    margin-top: 100px;
}

#avatarMostrado {
    width: 250px;
    border-radius: 20px;
    margin-top: 20px;
}